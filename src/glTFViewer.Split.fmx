      Size.Width = 836.000000000000000000
      Size.Height = 20.000000000000000000
      Position.Y = 54.000000000000000000
      Size.PlatformDefault = False
    end
    object lblHowTo: TLabel
      Align = Top
      Size.Width = 836.000000000000000000
      Size.Height = 20.000000000000000000
      Position.Y = 74.000000000000000000
      Text = 'Type one row per animation; a new empty row appears as you ' +
        'go. Gaps between the ranges are fine, and a row left empty ' +
        'is ignored.'
      Size.PlatformDefault = False
    end
    object chkIncreasing: TCheckBox
      Align = Top
      Position.Y = 94.000000000000000000
      Size.Width = 836.000000000000000000
      Size.Height = 24.000000000000000000
      IsChecked = True
      Text = 'Frames increase from row to row (a row may start where the ' +
        'row before ends)'
      OnChange = chkIncreasingChange
      Size.PlatformDefault = False
    end
  end
  object grdRanges: TStringGrid
