        Position.Y = 4.000000000000000000
        AutoSize = True
        Margins.Right = 6.000000000000000000
        StyledSettings = [Family, Size, Style, FontColor]
        TextSettings.WordWrap = False
        Text = 'Last frame:'
        Size.PlatformDefault = False
      end
      object edtLastFrame: TEdit
