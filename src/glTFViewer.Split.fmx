        Position.Y = 4.000000000000000000
        AutoSize = True
        Margins.Right = 6.000000000000000000
        StyledSettings = [Family, Size, Style, FontColor]
        TextSettings.WordWrap = False
        Text = 'Frame rate (per second):'
        Size.PlatformDefault = False
      end
      object edtRate: TEdit
        Align = Left
        Position.X = 156.000000000000000000
        Position.Y = 4.000000000000000000
        Size.Width = 80.000000000000000000
        Size.Height = 24.000000000000000000
        Margins.Right = 18.000000000000000000
        OnChangeTracking = edtRateChangeTracking
        Size.PlatformDefault = False
      end
      object lblLastFrame: TLabel
        Align = Left
        Size.Width = 150.000000000000000000
        Size.Height = 24.000000000000000000
