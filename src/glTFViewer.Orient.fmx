      Position.X = 16.000000000000000000
      Position.Y = 12.000000000000000000
      StyledSettings = [Family, Size, Style, FontColor]
      TextSettings.WordWrap = True
      TextSettings.VertAlign = Leading
      Text = 'Turns the whole model when it is saved, so it has the up ' +
        'and forward axes your engine expects without a starting ' +
        'rotation. Meshes, normals, nodes, animations and skins are ' +
        'all turned; the loaded model is not changed. X is applied ' +
        'first, then Y, then Z. Leave all three at 0 to save the ' +
        'model as it is.'
      Size.PlatformDefault = False
    end
